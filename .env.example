# Copy this file to `.env` for local development and fill in real values.
# NEVER commit a real `.env` file.

# Required. The privileged OpenRouter "Management Key" used to mint trial
# keys under the company's own OpenRouter account. Keep this secret; this
# service is the only place it should ever live.
OPENROUTER_MANAGEMENT_KEY=sk-or-v1-REPLACE_ME

# Optional (defaults shown).
DATABASE_URL=sqlite://trial-broker.db
DAILY_BUDGET_USD_CAP=50.0
TRIAL_KEY_LIMIT_USD=1.0
# How often OpenRouter resets each key's spend counter: monthly | daily.
# `monthly` means a trial user costs at most $1 EVER PER MONTH; `daily`
# would mean at most $1 per day, i.e. up to ~$30/month each.
TRIAL_KEY_LIMIT_RESET=monthly
TRIAL_KEY_EXPIRES_DAYS=90
LISTEN_ADDR=0.0.0.0:8787
PER_IP_RATE_LIMIT_PER_HOUR=5

# Optional: control log verbosity (tracing-subscriber EnvFilter syntax).
# RUST_LOG=dream_trial_broker=info,tower_http=info
