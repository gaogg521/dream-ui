# Copy this file to `.env` for local development and fill in real values.
# NEVER commit a real `.env` file.

# Required. The privileged OpenRouter "Management Key" used to mint trial
# keys under the company's own OpenRouter account. Keep this secret; this
# service is the only place it should ever live.
OPENROUTER_MANAGEMENT_KEY=sk-or-v1-REPLACE_ME

# Optional (defaults shown).
DATABASE_URL=sqlite://trial-broker.db
DAILY_BUDGET_USD_CAP=50.0
TRIAL_KEY_LIMIT_USD=1.0
# How often OpenRouter resets each key's spend counter: monthly | daily.
# `monthly` means a trial user costs at most $1 EVER PER MONTH; `daily`
# would mean at most $1 per day, i.e. up to ~$30/month each.
TRIAL_KEY_LIMIT_RESET=monthly
TRIAL_KEY_EXPIRES_DAYS=90
LISTEN_ADDR=0.0.0.0:8787
PER_IP_RATE_LIMIT_PER_HOUR=5

# The broker's own externally-reachable base URL (scheme + host + any reverse
# proxy path prefix, no trailing slash). Mode B's claim response builds the
# client's proxy base_url from this. Defaults to http://<LISTEN_ADDR>, which is
# only correct for local dev — set it in production.
# PUBLIC_BASE_URL=https://work.1oneclaw.com/trial-broker

# --- Mode B: metered proxy (optional) ---------------------------------------
# Leave BAOYUN_MASTER_API_KEY unset to keep mode B fully disabled; every
# /v1/metered/* route then 404s and mode A is untouched.
#
# The single Baoyun key the broker holds and swaps onto every forwarded
# request. Secret. Enables the baoyun metered vendor when present.
# BAOYUN_MASTER_API_KEY=sk-REPLACE_ME
# BAOYUN_BASE_URL=https://ai-api.baoyun.com
# One-time free grant for a fresh account, in CNY cents (分). 1000 = ¥10.00.
# BAOYUN_FREE_GRANT_CENTS=1000
# Comma-separated preset model list for the client (first is the default).
# Unset serves an unverified placeholder — curate before promoting the offer.
# BAOYUN_TRIAL_MODELS=deepseek-chat,deepseek-reasoner
# Shared secret the mock payment webhook body must carry. The mock gateway is
# the only one implemented (Phase 1); real Alipay/WeChat come with a merchant
# account (Phase 4).
# MOCK_GATEWAY_SECRET=mock-secret

# --- Mode C: hosted web search (optional) -----------------------------------
# Leave SEARCH_TAVILY_API_KEY unset to keep mode C disabled; /v1/search then
# answers 503 search_unavailable and the desktop client falls back to asking
# the user for their own provider key.
#
# Why the key lives here and not in the app: dream-ui is a public repository
# and an Electron asar is a readable archive, so a bundled key is a published
# key -- scanned, revoked, and broken for every user at once.
# SEARCH_TAVILY_API_KEY=tvly-REPLACE_ME
# SEARCH_TAVILY_BASE_URL=https://api.tavily.com/search
#
# A second provider, tried when the first cannot answer. Worth having for more
# than redundancy: measured against the live APIs, a Chinese-language query
# answered by Tavily came back with a university course page and a 200, while
# Zhipu returned that week's industry figures. A Chinese query therefore asks
# Zhipu first; an English one keeps the order below.
#
# NOTE on links: Zhipu's own engines (search_std / search_pro) return dated
# summaries with an EMPTY link for Chinese news -- measured 0 of 10 -- because
# that content is licensed into their index rather than crawled. Those results
# are still served, marked as unlinked. Only the third-party engines
# (search_pro_sogou / search_pro_quark, 0.05 CNY a call) carry URLs. This
# service is pinned to search_std (0.01) deliberately; the desktop client lets
# a user who brings their OWN key pick any of the four.
# SEARCH_ZHIPU_API_KEY=REPLACE_ME
# SEARCH_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/web_search
# Order providers are tried in. Default: tavily,zhipu
# SEARCH_PROVIDER_ORDER=tavily,zhipu
# Searches one install may run per UTC day.
# SEARCH_DAILY_LIMIT_PER_INSTALL=50
# Searches every install together may run per UTC day -- the spend cap.
# SEARCH_GLOBAL_DAILY_LIMIT=5000
# Per-IP sliding window for /v1/search only (mode A's 5/hour is far too tight
# for search, where one conversation can run several queries in a minute).
# SEARCH_RATE_LIMIT_PER_HOUR=60

# Optional: control log verbosity (tracing-subscriber EnvFilter syntax).
# RUST_LOG=dream_trial_broker=info,tower_http=info
